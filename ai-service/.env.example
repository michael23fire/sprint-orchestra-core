# --- Downstream ---
AI_VECTORIZATION_SERVICE_URL=http://localhost:8100

# --- LLM provider ---
# anthropic: production path (official SDK, claude-opus-4-8 default). Needs ANTHROPIC_API_KEY set
# (or `ant auth login`) — the SDK resolves credentials itself; AI_ANTHROPIC_API_KEY below is optional.
# openai_compatible: local OpenAI-compatible server (e.g. LM Studio) — no cloud key needed, for
# running/testing the agent loop locally. Point AI_AGENT_MODEL at a tool-calling-capable local model.
AI_LLM_PROVIDER=anthropic
AI_ANTHROPIC_API_KEY=
AI_AGENT_MODEL=claude-opus-4-8

# For AI_LLM_PROVIDER=openai_compatible:
# AI_AGENT_MODEL=qwen/qwen3.6-35b-a3b
# AI_OPENAI_BASE_URL=http://localhost:1234/v1
# AI_OPENAI_API_KEY=local

# --- Agent loop ---
AI_MAX_TOOL_ITERATIONS=4
AI_RETRIEVAL_TOP_K=5
AI_MAX_OUTPUT_TOKENS=2048
# HTTP timeout for the openai_compatible provider only — local model generation can take well over
# a minute; bump this rather than the model catching a spurious ReadTimeout mid-generation.
AI_LLM_REQUEST_TIMEOUT_SECONDS=300

# Optional extra live-answer verifier; costs one additional LLM call for non-abstaining answers.
AI_FAITHFULNESS_CHECK_ENABLED=false

# Optional planner <-> critic LangGraph generation path. Durable rollout below works with either
# planning implementation.
AI_EPIC_PLANNING_MULTIAGENT_ENABLED=false

# --- Shared Redis semantic answer cache (Redis Stack / RediSearch) ---
AI_CACHE_ENABLED=true
AI_REDIS_URL=redis://localhost:6379/0
AI_CACHE_TTL_SECONDS=600
AI_CACHE_SIMILARITY_THRESHOLD=0.97
AI_CACHE_MAX_ENTRIES=500
# Must match VEC_EMBEDDING_DIM.
AI_CACHE_EMBEDDING_DIM=1024

# --- Caller identity / space authorization ---
AI_SPACE_MEMBERSHIP_CHECK_ENABLED=true
AI_JIRA_BACKEND_URL=http://localhost:8081
# Must match gateway INTERNAL_GATEWAY_TOKEN and jira-backend's internal gateway token.
AI_INTERNAL_GATEWAY_TOKEN=dev-internal-gateway-token-min-32-chars-long!!
AI_SPACE_MEMBERSHIP_CACHE_TTL_SECONDS=60

# --- Durable LangGraph workflows (checkpointed in core Postgres) ---
AI_EPIC_ROLLOUT_ENABLED=true
AI_EPIC_ROLLOUT_CHECKPOINT_DB_URL=postgresql://poc:poc123@localhost:5432/pocdb

AI_SPRINT_RECOVERY_ENABLED=true
# When both workflows are enabled, the two checkpoint DSNs must match because they share a saver.
AI_SPRINT_RECOVERY_CHECKPOINT_DB_URL=postgresql://poc:poc123@localhost:5432/pocdb
AI_SPRINT_RECOVERY_MAX_CLARIFICATION_ROUNDS=2
AI_SPRINT_RECOVERY_MAX_ESCALATION_ROUNDS=2
AI_SPRINT_RECOVERY_MAX_PLAN_REVISION_ROUNDS=2
AI_SPRINT_RECOVERY_MAX_TOKEN_BUDGET=200000
AI_SPRINT_RECOVERY_KAFKA_ENABLED=true
AI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AI_KAFKA_CONTENT_TOPIC=jira.content.ingestion
AI_SPRINT_RECOVERY_KAFKA_GROUP_ID=ai-service-sprint-recovery
# Optional Slack-compatible incoming webhook; unset means warning logs only.
# AI_SPRINT_RECOVERY_ESCALATION_WEBHOOK_URL=

# --- Logging ---
AI_LOG_LEVEL=INFO
AI_LOG_JSON=true

# --- Observability: Phoenix tracing (trace-level view of LLM calls; complements the
# Prometheus/Grafana metrics in app/observability.py — see app/tracing.py for exact coverage) ---
# Off by default: needs the Phoenix container running
# (docker compose -f observability/docker-compose.observability.yml up -d) to have somewhere to send
# spans to.
AI_PHOENIX_ENABLED=false
AI_PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
AI_PHOENIX_PROJECT_NAME=sprint-orchestra-ai-service
