# Copy to .env for local runs. All keys are prefixed VEC_ (see app/config.py).

# --- Postgres (this service's OWN pgvector database; docker-compose `vecdb` on :5433) ---
VEC_PG_DSN=postgresql://vec:vec123@localhost:5433/vecdb

# --- Kafka ---
VEC_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VEC_KAFKA_CONTENT_TOPIC=jira.content.ingestion
VEC_KAFKA_ATTACHMENT_TOPIC=jira.attachment.ingestion
VEC_KAFKA_CONSUME_ATTACHMENTS=false

# --- Embeddings ---
# Provider: voyage (Anthropic-recommended) | openai | fake (no key, deterministic vectors)
VEC_EMBEDDING_PROVIDER=voyage
VEC_EMBEDDING_MODEL=voyage-3
VEC_EMBEDDING_DIM=1024
VEC_VOYAGE_API_KEY=
VEC_OPENAI_API_KEY=
# OpenAI-compatible base URL. Point at a local server to run real embeddings with no cloud key,
# e.g. LM Studio: VEC_EMBEDDING_PROVIDER=openai, VEC_OPENAI_BASE_URL=http://localhost:1234/v1,
# VEC_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b (1024-dim).
VEC_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Object storage (MinIO locally) — only needed if VEC_KAFKA_CONSUME_ATTACHMENTS=true ---
VEC_S3_ENDPOINT=http://localhost:9000
VEC_S3_ACCESS_KEY=minioadmin
VEC_S3_SECRET_KEY=minioadmin

# --- Attachment parsing ---
VEC_DOCLING_DO_OCR=false
VEC_DOCLING_DO_TABLE_STRUCTURE=false

# --- Reranking (second-stage cross-encoder over the fused hybrid candidate pool) ---
# On by default; see README "Reranking" section for measured latency.
VEC_RERANK_ENABLED=true
VEC_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VEC_RERANK_CANDIDATE_POOL=20
# Minimum cross-encoder score to keep a hit (unset = no filtering, rerank only reorders/truncates).
# ms-marco-MiniLM-L-6-v2 scores are unbounded logits, not 0-1 cosine — tune against your own data.
VEC_RERANK_SCORE_THRESHOLD=

# --- Logging ---
VEC_LOG_LEVEL=INFO
VEC_LOG_JSON=true
