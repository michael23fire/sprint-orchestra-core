# Copy to .env for local runs. All keys are prefixed VEC_ (see app/config.py).

# --- Postgres (this service's OWN pgvector database; docker-compose `vecdb` on :5433) ---
VEC_PG_DSN=postgresql://vec:vec123@localhost:5433/vecdb
VEC_PG_POOL_MIN_SIZE=1
VEC_PG_POOL_MAX_SIZE=8

# --- Kafka ---
VEC_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
VEC_KAFKA_CONTENT_TOPIC=jira.content.ingestion
VEC_KAFKA_ATTACHMENT_TOPIC=jira.attachment.ingestion
VEC_KAFKA_GROUP_ID=vectorization-service
VEC_KAFKA_AUTO_OFFSET_RESET=earliest
VEC_KAFKA_CONSUME_ATTACHMENTS=false

# --- Embeddings ---
# Provider: voyage (Anthropic-recommended) | openai | fake (no key, deterministic vectors)
VEC_EMBEDDING_PROVIDER=voyage
VEC_EMBEDDING_MODEL=voyage-3
VEC_EMBEDDING_DIM=1024
VEC_VOYAGE_API_KEY=
VEC_OPENAI_API_KEY=
# OpenAI-compatible base URL. Point at a local server to run real embeddings with no cloud key,
# e.g. LM Studio: VEC_EMBEDDING_PROVIDER=openai, VEC_OPENAI_BASE_URL=http://localhost:1234/v1,
# VEC_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b (1024-dim).
VEC_OPENAI_BASE_URL=https://api.openai.com/v1
VEC_EMBEDDING_BATCH_SIZE=64
VEC_EMBEDDING_MAX_RETRIES=3

# --- Chunking ---
VEC_CHUNK_SIZE_TOKENS=800
VEC_CHUNK_OVERLAP_TOKENS=130

# --- Optional contextual retrieval (one LLM call per chunk; off by default) ---
VEC_CONTEXTUAL_RETRIEVAL_ENABLED=false
VEC_CONTEXTUAL_LLM_PROVIDER=anthropic
VEC_CONTEXTUAL_ANTHROPIC_API_KEY=
VEC_CONTEXTUAL_ANTHROPIC_MODEL=claude-haiku-4-5
VEC_CONTEXTUAL_OPENAI_BASE_URL=http://localhost:1234/v1
VEC_CONTEXTUAL_OPENAI_API_KEY=local
VEC_CONTEXTUAL_OPENAI_MODEL=openai/gpt-oss-20b

# --- Object storage (MinIO locally) — only needed if VEC_KAFKA_CONSUME_ATTACHMENTS=true ---
VEC_S3_ENDPOINT=http://localhost:9000
VEC_S3_ACCESS_KEY=minioadmin
VEC_S3_SECRET_KEY=minioadmin
VEC_S3_REGION=us-east-1

# --- Attachment parsing ---
VEC_DOCLING_DO_OCR=false
VEC_DOCLING_DO_TABLE_STRUCTURE=false
VEC_ATTACHMENT_MAX_BYTES=26214400
VEC_OCR_MIN_CONFIDENCE=0.4

# --- VLM fallback for images EasyOCR struggled with (app/ingest/vlm_describer.py) ---
# Off by default — a real per-escalated-image LLM call; see README "Chunking & attachment handling"
# and docs/RAG_ACCURACY_CASE_STUDIES.md Case Study 30.
VEC_VLM_OCR_ENABLED=false
VEC_VLM_PROVIDER=openai_compatible
VEC_VLM_ANTHROPIC_API_KEY=
VEC_VLM_ANTHROPIC_MODEL=claude-opus-4-8
VEC_VLM_OPENAI_BASE_URL=https://api.openai.com/v1
VEC_VLM_OPENAI_MODEL=gpt-5.6-luna
VEC_VLM_OPENAI_API_KEY=
# Set both flags to parse scanned/image-heavy PDFs page-by-page with the VLM. Docling remains the
# first parser; only scan-like or visual pages are rendered, up to the configured cap.
VEC_VLM_PDF_ENABLED=false
VEC_VLM_PDF_RENDER_DPI=200
VEC_VLM_PDF_MAX_PAGES=12
VEC_VLM_PDF_MIN_TEXT_CHARS=80
VEC_VLM_PDF_INCLUDE_VISUAL_PAGES=true
# 500 can truncate dense tables; 2000 is a safer production default for a selected PDF page.
VEC_VLM_MAX_COMPLETION_TOKENS=2000

# --- Reranking (second-stage cross-encoder over the fused hybrid candidate pool) ---
# On by default; see README "Reranking" section for measured latency.
VEC_RERANK_ENABLED=true
VEC_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VEC_RERANK_CANDIDATE_POOL=20
# Minimum cross-encoder score to keep a hit (unset = no filtering, rerank only reorders/truncates).
# ms-marco-MiniLM-L-6-v2 scores are unbounded logits, not 0-1 cosine — tune against your own data.
# Leave this line commented out to actually get "unset": pydantic-settings tries to parse an empty
# string as a float for a non-str Optional field rather than treating "" as absent, so
# `VEC_RERANK_SCORE_THRESHOLD=` (present but blank) fails Settings validation at startup instead of
# quietly meaning "no threshold." Uncomment and give it a real number if you want to set one.
# VEC_RERANK_SCORE_THRESHOLD=

# --- Logging ---
VEC_LOG_LEVEL=INFO
VEC_LOG_JSON=true
