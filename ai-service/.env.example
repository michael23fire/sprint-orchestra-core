# --- Downstream ---
AI_VECTORIZATION_SERVICE_URL=http://localhost:8100

# --- LLM provider ---
# anthropic: production path (official SDK, claude-opus-4-8 default). Needs ANTHROPIC_API_KEY set
# (or `ant auth login`) — the SDK resolves credentials itself; AI_ANTHROPIC_API_KEY below is optional.
# openai_compatible: local OpenAI-compatible server (e.g. LM Studio) — no cloud key needed, for
# running/testing the agent loop locally. Point AI_AGENT_MODEL at a tool-calling-capable local model.
AI_LLM_PROVIDER=anthropic
AI_ANTHROPIC_API_KEY=
AI_AGENT_MODEL=claude-opus-4-8

# For AI_LLM_PROVIDER=openai_compatible:
# AI_AGENT_MODEL=qwen/qwen3.6-35b-a3b
# AI_OPENAI_BASE_URL=http://localhost:1234/v1
# AI_OPENAI_API_KEY=local

# --- Agent loop ---
AI_MAX_TOOL_ITERATIONS=4
AI_RETRIEVAL_TOP_K=5
# HTTP timeout for the openai_compatible provider only — local model generation can take well over
# a minute; bump this rather than the model catching a spurious ReadTimeout mid-generation.
AI_LLM_REQUEST_TIMEOUT_SECONDS=300

# --- Logging ---
AI_LOG_LEVEL=INFO
AI_LOG_JSON=true

# --- Observability: Phoenix tracing (trace-level view of LLM calls; complements the
# Prometheus/Grafana metrics in app/observability.py — see app/tracing.py for exact coverage) ---
# Off by default: needs the Phoenix container running
# (docker compose -f observability/docker-compose.observability.yml up -d) to have somewhere to send
# spans to.
AI_PHOENIX_ENABLED=false
AI_PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
AI_PHOENIX_PROJECT_NAME=sprint-orchestra-ai-service
